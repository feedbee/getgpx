{
  "name": "getgpx",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node src/backend/index.js",
    "preview": "vite preview",
    "test": "npm run test:fast",
    "test:fast": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:performance": "vitest run tests/performance/gpx-load.test.js",
    "test:all": "npm run test:fast && npm run test:integration",
    "lint": "eslint .",
    "check": "npm run locales:check && npm run lint && npm run test:fast && npm run build",
    "release:check": "npm ci && npm run check",
    "previews:regenerate": "node scripts/regenerate-track-previews.js",
    "locales:check": "node scripts/check-locales.js",
    "test:api": "vitest run tests/unit/backend/api tests/unit/backend/route-paths.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@scalar/api-reference": "1.73.0",
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "intl-messageformat": "^12.1.3",
    "leaflet": "^1.9.4",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "5.33.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "^10.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@scalar/agent-chat": {
      "@ai-sdk/provider-utils": "4.0.33"
    }
  }
}
