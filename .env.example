MONGODB_URI=mongodb://localhost:27017/getgpx
PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
HOMEPAGE_TRACK_CACHE_ENABLED=false
# Client setting: restart Vite after changes; production uses the build-time value.
SORT_DISTRIBUTION_BARS_BY_SIZE=false
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Callback origin is also the allowed browser origin for API requests.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
TRACK_S3_BUCKET=replace-with-private-track-bucket
AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=replace-with-development-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-development-secret-key
# AWS_SESSION_TOKEN=replace-with-temporary-session-token
# AWS_PROFILE=replace-with-development-profile
# TRACK_S3_PREFIX=dev
# TRACK_PREVIEW_MAX_POINTS=200
# TRACK_PREVIEW_PROVIDER=mapbox
# MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token
# MAPBOX_PREVIEW_STYLE=mapbox/streets-v12
# TRACK_FILE_DELIVERY=stream
# nginx delivery requires the matching X-Accel-Redirect proxy configuration.
# Production nginx delivery additionally requires:
# TRACK_CLOUDFRONT_DOMAIN=example.cloudfront.net
# TRACK_CLOUDFRONT_PUBLIC_KEY_ID=replace-with-public-key-id
# TRACK_CLOUDFRONT_PRIVATE_KEY_PATH=/run/secrets/cloudfront-private-key.pem
# VALHALLA_URL=https://your-valhalla.example/trace_attributes
# Segment splitting reserves 1% distance headroom.
# VALHALLA_MAX_SEGMENT_KM=200
# ELEVATION_URL=https://your-valhalla.example/height
# OVERPASS_URL=https://your-overpass.example/api/interpreter

# SITE_URL=https://getgpx.link
