{
  "name": "track-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/backend/index.js",
    "preview": "vite preview",
    "test": "npm run test:fast",
    "test:fast": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration/database.test.js",
    "test:all": "npm run test:fast && npm run test:integration",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:fast && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
