{
  "name": "getgpx",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/backend/index.js",
    "migrate:track-public-ids": "node --env-file-if-exists=.env scripts/migrate-track-public-ids.js",
    "preview": "vite preview",
    "test": "npm run test:fast",
    "test:fast": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration/database.test.js",
    "test:performance": "vitest run tests/performance/gpx-load.test.js",
    "test:all": "npm run test:fast && npm run test:integration",
    "lint": "eslint .",
    "check": "npm run locales:check && npm run lint && npm run test:fast && npm run build",
    "locales:check": "node scripts/check-locales.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "intl-messageformat": "^12.1.2",
    "leaflet": "^1.9.4",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
